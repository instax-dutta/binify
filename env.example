# Postgres — the single datastore (encrypted payloads + metadata in one table).
#
# USE THE POOLED ENDPOINT. Serverless instances scale out and recycle
# constantly; direct connections exhaust Postgres' backend slots quickly. On
# Neon the pooled hostname contains "-pooler".
#
#   postgresql://user:pass@ep-xxx-pooler.<region>.aws.neon.tech/binify?sslmode=require
#
# Verify reachability and latency before trusting it:
#     npm run db:check
# Every API call pays at least one round trip to the database, so distance
# between the app region and the database region is felt on every request.
DATABASE_URL=postgresql://user:password@host:5432/binify
# Set to "false" only when the URL carries sslmode=disable.
DATABASE_SSL=true
# Max connections per serverless instance. Keep this x max concurrent instances
# below the server's max_connections. `npm run db:check` prints the limit.
DATABASE_POOL_MAX=5

# Maximum paste size in bytes (1KB - 4MB, default 4MB).
#
# This is a budget decision, not a technical one. Every paste READ pulls its
# payload back out of the database, so this number divides into how many reads
# the monthly egress allowance can serve. With 5 GB/month:
#   4MB -> ~1,250 reads   1MB -> ~5,000   256KB -> ~20,000
# Exceeding the allowance suspends the database until the next billing period.
# MAX_PASTE_SIZE=4194304

# Pepper for deletion-token HMACs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# The tokens themselves are stored only as HMACs, so a database dump cannot
# revoke or rotate anyone's paste. Rotating this invalidates existing tokens.
TOKEN_PEPPER=replace-me-with-32-random-bytes

# Guards POST /api/init. Required — the endpoint refuses to run without it.
INIT_SECRET=replace-me

# Guards GET /api/cron/cleanup. Vercel sends this as a bearer token.
CRON_SECRET=replace-me

# Set to "true" ONLY when a reverse proxy you control strips inbound
# X-Forwarded-For and writes its own. Without it, X-Forwarded-For is ignored and
# unverified clients share one rate-limit bucket — callers cannot pick their own
# bucket by rotating the header. On Vercel, request.ip is supplied by the
# platform, so this stays false.
TRUST_PROXY=false

# Canonical origin, used by metadata and the sitemap.
NEXT_PUBLIC_APP_URL=https://bin.sdad.pro